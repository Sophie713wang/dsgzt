        <div class="nav-item" onclick="openSubPage('calendar')"><span class="nav-icon">📅</span>日历</div>
        <div class="nav-item" onclick="openSubPage('notes')"><span class="nav-icon">📝</span>笔记</div>
        <div class="nav-item"><span class="nav-icon">🧸</span>更多</div>
