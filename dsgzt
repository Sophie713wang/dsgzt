    <script>
        // 核心数据结构
        let appData = {
            plans: [
                { id: '1', text: '早睡 23:00', done: false },
                { id: '2', text: '记录身体状况', done: false },
                { id: '3', text: '学习日语 (可选)', done: false },
                { id: '4', text: '看一本喜欢的书', done: false },
                { id: '5', text: '好好吃饭 ♡', done: false }
            ],
            planDate: '', // 记录是哪一天的计划
            activities: [], // 近期动态
            health: { temp: '', heart: '', bp: '' },
            meds: [{ text: 'ATRA', time: '早/晚', done: true }, { text: 'ATO', time: '进行中', done: false }],
            hospital: { date: '2026-09-20' },
            collections: {
                games: ['塞尔达传说', '星露谷物语', '动物森友会'],
                movies: ['奥本海默', '沙丘2', '疯狂动物城'],
                dramas: ['老友记', '权力的游戏'],
                books: ['百年孤独', '活着', '被讨厌的勇气']
            },
            notes: '' // 备忘录
        };

        const todayStr = new Date().toISOString().split('T')[0];

        // 初始化：从本地读取数据
        function init() {
            const saved = localStorage.getItem('MyLittleWorldData');
            if (saved) {
                appData = JSON.parse(saved);
            }
            
            // 每日重置逻辑
            if (appData.planDate !== todayStr) {
                // 新的一天，清空勾选状态，保留计划内容
                appData.plans.forEach(p => p.done = false);
                appData.planDate = todayStr;
                saveData();
            }

            updateDateDisplay();
            renderPlans();
            renderActivities();
            renderQuickCollections();
            renderHealthPanel();
            
            // 初始添加一条动态
            if (appData.activities.length === 0) {
                addActivity('欢迎来到你的小小世界！');
            }
        }

        function saveData() {
            localStorage.setItem('MyLittleWorldData', JSON.stringify(appData));
        }

        function updateDateDisplay() {
            const d = new Date();
            const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
            document.getElementById('currentDate').innerText = `${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日 (${days[d.getDay()]})`;
        }

        // --- 今日计划逻辑 ---
        function renderPlans() {
            const container = document.getElementById('today-plan-list');
            container.innerHTML = '';
            appData.plans.forEach((plan, index) => {
                const div = document.createElement('div');
                div.className = `task-item ${plan.done ? 'done' : ''}`;
                div.innerHTML = `
                    <div class="circle-check ${plan.done ? 'checked' : ''}" onclick="togglePlan(${index})"></div>
                    <span class="task-text">${plan.text}</span>
                    <span class="del-btn" onclick="deletePlan(${index})">✕</span>
                `;
                container.appendChild(div);
            });
        }

        function togglePlan(index) {
            appData.plans[index].done = !appData.plans[index].done;
            if(appData.plans[index].done) {
                addActivity(`完成计划：${appData.plans[index].text}`);
            }
            saveData();
            renderPlans();
        }

        function addPlan() {
            const input = document.getElementById('new-plan-input');
            if (!input.value.trim()) return;
            appData.plans.push({ id: Date.now().toString(), text: input.value.trim(), done: false });
            input.value = '';
            saveData();
            renderPlans();
        }

        function deletePlan(index) {
            appData.plans.splice(index, 1);
            saveData();
            renderPlans();
        }

        // --- 近期动态 ---
        function addActivity(text) {
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            appData.activities.unshift({ text, date: todayStr, time });
            if (appData.activities.length > 5) appData.activities.pop();
            saveData();
            renderActivities();
        }

        function renderActivities() {
            const container = document.getElementById('recent-activity');
            container.innerHTML = '';
            appData.activities.forEach(act => {
                const div = document.createElement('div');
                div.style.display = 'flex';
                div.style.gap = '10px';
                div.innerHTML = `<span style="color:#d1c4e9;">●</span> <span style="flex:1;">${act.text}</span> <span style="color:#ccc; font-size:12px;">${act.date === todayStr ? act.time : act.date.slice(5)}</span>`;
                container.appendChild(div);
            });
        }

        // --- 右侧面板渲染 ---
        function renderHealthPanel() {
            document.getElementById('val-temp').innerText = appData.health.temp || '-- °C';
            document.getElementById('val-heart').innerText = appData.health.heart || '-- bpm';
            document.getElementById('val-bp').innerText = appData.health.bp || '-- / -- mmHg';
            
            const medList = document.getElementById('med-list');
            medList.innerHTML = '';
            appData.meds.forEach(m => {
                medList.innerHTML += `<div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span>${m.done ? '✅' : '⏳'} ${m.text}</span>
                    <span style="color:#ccc;">${m.time}</span>
                </div>`;
            });

            if (appData.hospital.date) {
                const start = new Date(appData.hospital.date);
                const diff = Math.ceil((new Date() - start) / (1000 * 60 * 60 * 24));
                document.getElementById('hospital-days').innerText = `${diff > 0 ? diff : 0} 天`;
                document.getElementById('hospital-date').innerText = appData.hospital.date;
            }
        }

        // --- 收藏库快捷入口 ---
        function renderQuickCollections() {
            const container = document.getElementById('quick-collections');
            container.innerHTML = '';
            const items = [
                { name: '待玩游戏', count: appData.collections.games.length, icon: '🎮', type: 'games' },
                { name: '待看电影', count: appData.collections.movies.length, icon: '🎬', type: 'movies' },
                { name: '待追的剧', count: appData.collections.dramas.length, icon: '📺', type: 'dramas' },
                { name: '想读的书', count: appData.collections.books.length, icon: '📚', type: 'books' }
            ];
            items.forEach(item => {
                const div = document.createElement('div');
                div.style.cssText = 'min-width: 100px; background: rgba(255,255,255,0.7); padding: 12px; border-radius: 12px; text-align: center; cursor: pointer;';
                div.onclick = () => openSubPage('fun');
                div.innerHTML = `
                    <div style="font-size: 24px; margin-bottom: 4px;">${item.icon}</div>
                    <div style="font-size: 12px; font-weight: 600; color: #555;">${item.name}</div>
                    <div style="font-size: 10px; color: #999;">${item.count} 项</div>
                `;
                container.appendChild(div);
            });
        }

        // --- 子页面系统 ---
        const subPage = document.getElementById('subPage');
        const subTitle = document.getElementById('subPageTitle');
        const subContent = document.getElementById('subPageContent');

        function openSubPage(type) {
            subPage.classList.add('open');
            subContent.innerHTML = '';

            if (type === 'sop') {
                subTitle.innerText = 'SOP 每日打卡';
                subContent.innerHTML = `
                    <div class="glass-card">
                        <p style="color:#888; font-size:12px; margin-bottom:10px;">每日早上 8:00 自动重置状态哦</p>
                        <div id="sub-sop-list"></div>
                    </div>
                `;
                const list = document.getElementById('sub-sop-list');
                // 复用今日计划的数据展示
                appData.plans.forEach((p, i) => {
                    list.innerHTML += `<div class="task-item ${p.done?'done':''}">
                        <div class="circle-check ${p.done?'checked':''}" onclick="togglePlan(${i}); openSubPage('sop');"></div>
                        <span class="task-text">${p.text}</span>
                    </div>`;
                });
            } 
            else if (type === 'health-record') {
                subTitle.innerText = '身体与住院记录';
                subContent.innerHTML = `
                    <div class="glass-card" style="margin-bottom:16px;">
                        <div class="card-header">今日身体数据</div>
                        <div class="input-box"><input type="text" id="sub-temp" placeholder="体温 (如 36.5)" value="${appData.health.temp}"></div>
                        <div class="input-box"><input type="text" id="sub-heart" placeholder="心率 (如 75)" value="${appData.health.heart}"></div>
                        <div class="input-box"><input type="text" id="sub-bp" placeholder="血压 (如 120/80)" value="${appData.health.bp}"></div>
                        <button class="add-btn" style="width:100%; margin-top:15px; padding:12px;" onclick="saveHealthData()">保存数据</button>
                    </div>
                    <div class="glass-card">
                        <div class="card-header">住院信息设置</div>
                        <div class="input-box"><input type="text" id="sub-hospital-date" placeholder="入院日期 (YYYY-MM-DD)" value="${appData.hospital.date}"></div>
                        <button class="add-btn" style="width:100%; margin-top:15px; padding:12px;" onclick="saveHospitalDate()">更新入院日</button>
                    </div>
                `;
            }
            else if (type === 'fun') {
                subTitle.innerText = '娱乐收藏库';
                subContent.innerHTML = `<div class="glass-card" id="sub-fun-content"></div>`;
                const container = document.getElementById('sub-fun-content');
                
                const categories = [
                    { key: 'games', label: '🎮 待玩游戏' },
                    { key: 'movies', label: '🎬 待看电影' },
                    { key: 'dramas', label: '📺 待追的剧' },
                    { key: 'books', label: '📚 想读的书' }
                ];

                categories.forEach(cat => {
                    let html = `<div class="card-header">${cat.label}</div><div id="list-${cat.key}">`;
                    appData.collections[cat.key].forEach((item, idx) => {
                        html += `<div class="task-item">
                            <span class="task-text">${item}</span>
                            <span class="del-btn" onclick="deleteCollectionItem('${cat.key}', ${idx})">✕</span>
                        </div>`;
                    });
                    html += `</div><div class="input-box">
                        <input type="text" id="input-${cat.key}" placeholder="添加...">
                        <button onclick="addCollectionItem('${cat.key}')">+</button>
                    </div><div style="height:20px;"></div>`;
                    container.innerHTML += html;
                });
            }
            else if (type === 'notes') {
                subTitle.innerText = '随记便签';
                subContent.innerHTML = `
                    <div class="glass-card">
                        <textarea id="sub-notes" style="width:100%; height:300px; border:none; background:transparent; outline:none; font-size:14px; line-height:1.6; color:#555;" placeholder="在这里记录你的碎碎念...">${appData.notes}</textarea>
                        <button class="add-btn" style="width:100%; margin-top:10px; padding:12px;" onclick="saveNotes()">保存笔记</button>
                    </div>
                `;
            }
            else {
                subTitle.innerText = '开发中...';
                subContent.innerHTML = '<p style="text-align:center; color:#999; margin-top:50px;">这里将放置更多可爱的小功能 ♡</p>';
            }
        }

        function closeSubPage() {
            subPage.classList.remove('open');
        }

        // 子页面数据保存逻辑
        function saveHealthData() {
            appData.health.temp = document.getElementById('sub-temp').value;
            appData.health.heart = document.getElementById('sub-heart').value;
            appData.health.bp = document.getElementById('sub-bp').value;
            saveData();
            renderHealthPanel();
            addActivity('更新了身体指标');
            closeSubPage();
        }

        function saveHospitalDate() {
            appData.hospital.date = document.getElementById('sub-hospital-date').value;
            saveData();
            renderHealthPanel();
            closeSubPage();
        }

        function addCollectionItem(key) {
            const input = document.getElementById(`input-${key}`);
            if (!input.value.trim()) return;
            appData.collections[key].push(input.value.trim());
            saveData();
            renderQuickCollections(); // 更新首页数字
            openSubPage('fun'); // 刷新子页面
        }

        function deleteCollectionItem(key, index) {
            appData.collections[key].splice(index, 1);
            saveData();
            renderQuickCollections();
            openSubPage('fun');
        }

        function saveNotes() {
            appData.notes = document.getElementById('sub-notes').value;
            saveData();
            alert('笔记已保存 ♡');
        }

        // 启动
        window.onload = init;

    </script>
</body>
</html>
`;

