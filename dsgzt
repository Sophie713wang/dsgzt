                    <div id="med-list" style="font-size:12px; color:#777;"></div>
                </div>
                <div style="margin-top: 20px; border-top: 1px dashed rgba(0,0,0,0.05); padding-top:15px;">
                    <div class="card-header" style="margin-bottom:8px; font-size:14px;">🏥 住院信息</div>
                    <div class="health-item"><span class="label">住院天数</span><span class="value" id="hospital-days">0 天</span></div>
                    <div class="health-item"><span class="label">入院日</span><span class="value" id="hospital-date">未设置</span></div>
